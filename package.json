{
  "name": "tkd-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tanstack/react-query": "5.108.0"
  },
  "scripts": {
    "mobile": "npm run start --workspace=@tkd/mobile",
    "mobile:android": "npm run android --workspace=@tkd/mobile",
    "mobile:ios": "npm run ios --workspace=@tkd/mobile",
    "mobile:web": "npm run web --workspace=@tkd/mobile",
    "mobile:typecheck": "npm run typecheck --workspace=@tkd/mobile",
    "mobile:test": "npm run test --workspace=@tkd/mobile",
    "mobile:lint": "npm run lint --workspace=@tkd/mobile",
    
    "web": "npm run dev --workspace=@tkd/web",
    "web:build": "npm run build --workspace=@tkd/web",
    "web:lint": "npm run lint --workspace=@tkd/web",
    "web:preview": "npm run preview --workspace=@tkd/web"
  }
}
